# HSBC AutoAssist Environment Configuration
# Do not commit this file to version control

# Database Configuration
DATABASE_URL=mysql+pymysql://root:passw0rd@localhost:3306/hsbc_autoassist

# JWT Configuration
SECRET_KEY=hsbc-autoassist-secret-key-2024-dc-automation
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# OpenAI GPT-4o Configuration
# Replace with your actual OpenAI API key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama Local LLM Configuration (Fallback)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
USE_OLLAMA_FALLBACK=true

# Splunk API Configuration (Optional)
SPLUNK_API_URL=https://splunk.hsbc.internal:8089
SPLUNK_API_TOKEN=your-splunk-api-token-here

# Ansible API Configuration (Optional)
ANSIBLE_API_URL=https://ansible-tower.hsbc.internal
ANSIBLE_API_TOKEN=your-ansible-api-token-here

# CORS Settings (Development)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","https://localhost:3000","https://localhost:3001"]

# HSBC Specific Settings
COMPANY_NAME=HSBC
DEPARTMENT="DC Automation Support Team"
BOT_NAME="DC AutoAssist"

# Development Settings
DEBUG=true
ENVIRONMENT=development